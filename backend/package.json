{
  "name": "echo-backend",
  "version": "2.0.0",
  "description": "Backend Node.js para la plataforma educativa Echo — Monolito Modular por Capas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "jest tests/integration --forceExit --detectOpenHandles --verbose",
    "seed": "node src/scripts/seed.js"
  },
  "keywords": ["echo", "educacion", "evaluaciones", "nodejs", "express", "mongodb"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
